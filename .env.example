# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ML Models
# Resolves against backend/
OCR_MODEL_PATH=checkpoints/ocr_model.pt
CLASSIFIER_MODEL_PATH=checkpoints/classifier_model.pt

# Device
DEVICE=cpu  # or cuda

# Storage
UPLOAD_DIR=/app/uploads
RESULT_DIR=/app/results

# Task settings
TASK_RESULT_TTL=3600  # 1 hour in seconds
